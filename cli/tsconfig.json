{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "~/composables/useSessions": ["./shims/useSessions.ts"],
      "~/composables/useRuns": ["./shims/useRuns.ts"],
      "~/*": ["../app/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
